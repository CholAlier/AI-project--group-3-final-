   "source": [
    "# ============================================================\n",
    "# DATA QUALITY CHECKS\n",
    "# ============================================================\n",
    "\n",
    "# Check for duplicate employee records.\n",
    "# Duplicate rows can affect the analysis and model training\n",
    "# by giving repeated records unnecessary influence.\n",
    "\n",
    "print(\"=== Duplicate Records ===\")\n",
    "print(df.duplicated().sum(), \"duplicate rows\")\n",
    "\n",
    "\n",
    "# Check the number of unique values in each column.\n",
    "# This helps identify categorical variables and columns\n",
    "# with very few distinct values.\n",
    "\n",
    "print(\"\\n=== Unique Values per Column ===\")\n",
    "print(df.nunique().sort_values())\n",
    "\n",
    "\n",
    "# Identify columns that contain only one unique value.\n",
    "# A constant column has the same value for every employee\n",
    "# and provides no useful information for predicting attrition.\n",
    "\n",
    "print(\"\\n=== Constant Columns ===\")\n",
    "constant_cols = [col for col in df.columns if df[col].nunique() <= 1]\n",
    "print(constant_cols)\n",
    "\n",
    "\n",
    "# Identify identifier columns.\n",
    "# A column with a different value for every single employee is an\n",
    "# identifier, not a characteristic. It cannot generalise to new\n",
    "# employees, so it must not be used as a predictor.\n",
    "\n",
    "print(\"\\n=== Identifier Columns ===\")\n",
    "id_cols = [col for col in df.columns if df[col].nunique() == len(df)]\n",
    "print(id_cols)"
   ]
  },

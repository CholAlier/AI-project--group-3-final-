   "source": [
    "### 3.2 How Many Employees Left?\n",
    "\n",
    "Only **16.1%** of employees left the company, so the target is **imbalanced**. This matters later when choosing evaluation metrics — accuracy alone can look high even if the model misses most leavers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell_04",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-12T19:49:12.367237Z",
     "iopub.status.busy": "2026-08-12T19:49:12.366235Z",
     "iopub.status.idle": "2026-08-12T19:49:12.797517Z",
     "shell.execute_reply": "2026-08-12T19:49:12.795507Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ============================================================\n",
    "# ATTRITION DISTRIBUTION\n",
    "# ============================================================\n",
    "\n",
    "# Count the number of employees in each attrition category:\n",
    "# \"Yes\" = employee left\n",
    "# \"No\"  = employee stayed\n",
    "attrition_counts = df[\"Attrition\"].value_counts()\n",
    "\n",
    "\n",
    "# Create a figure containing two charts:\n",
    "# 1. Bar chart showing the number of employees\n",
    "# 2. Pie chart showing the percentage distribution\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# BAR CHART — EMPLOYEE ATTRITION COUNT\n",
    "# ============================================================\n",
    "\n",
    "# Create a bar chart using the attrition categories and their counts.\n",
    "bars = axes[0].bar(attrition_counts.index, attrition_counts.values, edgecolor=\"white\")\n",
    "\n",
    "# Add a title and axis labels.\n",
    "axes[0].set_title(\"Employee Attrition Count\", fontweight=\"bold\")\n",
    "axes[0].set_xlabel(\"Attrition\")\n",
    "axes[0].set_ylabel(\"Number of Employees\")\n",
    "\n",
    "\n",
    "# Add the exact number of employees above each bar\n",
    "# to make the chart easier to interpret.\n",
    "for bar in bars:\n",
    "    axes[0].text(\n",
    "        bar.get_x() + bar.get_width() / 2,\n",
    "        bar.get_height() + 15,\n",
    "        f\"{int(bar.get_height())}\",\n",
    "        ha=\"center\",\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PIE CHART — EMPLOYEE ATTRITION PERCENTAGE\n",
    "# ============================================================\n",
    "\n",
    "# Create a pie chart showing the proportion of employees\n",
    "# who stayed versus those who left.\n",
    "axes[1].pie(\n",
    "    attrition_counts.values,\n",
    "    labels=attrition_counts.index,\n",
    "    autopct=\"%1.1f%%\",\n",
    "    startangle=90,\n",
    ")\n",
    "\n",
    "# Add a descriptive title to the pie chart.\n",
    "axes[1].set_title(\"Employee Attrition Split\", fontweight=\"bold\")\n",
    "\n",
    "\n",
    "# Automatically adjust spacing between the two charts.\n",
    "plt.tight_layout()\n",
    "\n",
    "# Display the completed charts.\n",
    "plt.show()"
   ]
  },

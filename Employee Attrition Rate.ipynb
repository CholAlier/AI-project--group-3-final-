   "source": [
    "# ============================================================\n",
    "# 6. MODEL EVALUATION\n",
    "# ============================================================\n",
    "\n",
    "# This section evaluates the performance of the two trained models:\n",
    "# 1. Logistic Regression\n",
    "# 2. Random Forest\n",
    "#\n",
    "# Both models are also used together by averaging their predicted\n",
    "# attrition probabilities to produce a combined risk score.\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# STEP 1: VALIDATION SET PERFORMANCE\n",
    "# ============================================================\n",
    "\n",
    "# The validation set contains 15% of the dataset.\n",
    "# It is used to evaluate the models before the final test.\n",
    "# The models have not seen this data during training.\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# IDENTIFY THE ATTRITION CLASS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# The target variable uses:\n",
    "# 0 = Employee stays\n",
    "# 1 = Employee leaves\n",
    "#\n",
    "# We identify the class representing \"Leave\" dynamically\n",
    "# from the Logistic Regression model.\n",
    "\n",
    "leave_class = int(max(lr_model.named_steps[\"logisticregression\"].classes_))\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# LOGISTIC REGRESSION — VALIDATION PREDICTIONS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Generate the predicted class for each employee.\n",
    "# The result is either 0 (Stay) or 1 (Leave).\n",
    "\n",
    "lr_val_pred = lr_model.predict(X_val)\n",
    "\n",
    "# Generate the probability that each employee will leave.\n",
    "# Only the probability belonging to the \"Leave\" class is selected.\n",
    "\n",
    "lr_val_proba = lr_model.predict_proba(X_val)[\n",
    "    :, list(lr_model.named_steps[\"logisticregression\"].classes_).index(leave_class)\n",
    "]\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# RANDOM FOREST — VALIDATION PREDICTIONS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Generate the predicted class for each employee.\n",
    "# The result is either 0 (Stay) or 1 (Leave).\n",
    "\n",
    "rf_val_pred = rf_model.predict(X_val)\n",
    "\n",
    "# Generate the probability that each employee will leave.\n",
    "# Only the probability belonging to the \"Leave\" class is selected.\n",
    "\n",
    "rf_val_proba = rf_model.predict_proba(X_val)[\n",
    "    :, list(rf_model.named_steps[\"randomforestclassifier\"].classes_).index(leave_class)\n",
    "]\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# COMBINED PROBABILITY — VALIDATION\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Both models provide an independent probability of employee attrition.\n",
    "#\n",
    "# The two probabilities are averaged to create one combined\n",
    "# attrition-risk score.\n",
    "#\n",
    "# Example:\n",
    "# Logistic Regression = 60%\n",
    "# Random Forest       = 40%\n",
    "# Combined Risk       = (60% + 40%) / 2 = 50%\n",
    "\n",
    "ens_val_proba = (lr_val_proba + rf_val_proba) / 2\n",
    "\n",
    "# Convert the combined probability into a final class prediction.\n",
    "#\n",
    "# 50% or higher = Leave\n",
    "# Below 50%     = Stay\n",
    "\n",
    "ens_val_pred = (ens_val_proba >= 0.50).astype(int)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# VALIDATION PERFORMANCE COMPARISON\n",
    "# ============================================================\n",
    "\n",
    "# Compare the performance of:\n",
    "# - Logistic Regression\n",
    "# - Random Forest\n",
    "# - Combined Prediction\n",
    "\n",
    "validation_results = pd.DataFrame(\n",
    "    {\n",
    "        \"Model\": [\n",
    "            \"Logistic Regression\",\n",
    "            \"Random Forest\",\n",
    "            \"Combined Prediction\",\n",
    "        ],\n",
    "        # Accuracy measures the overall percentage of\n",
    "        # correctly classified employees.\n",
    "        \"Accuracy\": [\n",
    "            round(accuracy_score(y_val, lr_val_pred), 4),\n",
    "            round(accuracy_score(y_val, rf_val_pred), 4),\n",
    "            round(accuracy_score(y_val, ens_val_pred), 4),\n",
    "        ],\n",
    "        # Precision measures how many employees predicted\n",
    "        # to leave actually left.\n",
    "        \"Precision\": [\n",
    "            round(\n",
    "                precision_score(\n",
    "                    y_val,\n",
    "                    lr_val_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "            round(\n",
    "                precision_score(\n",
    "                    y_val,\n",
    "                    rf_val_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "            round(\n",
    "                precision_score(\n",
    "                    y_val,\n",
    "                    ens_val_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "        ],\n",
    "        # Recall measures how many of the employees who\n",
    "        # actually left were correctly identified.\n",
    "        \"Recall\": [\n",
    "            round(\n",
    "                recall_score(\n",
    "                    y_val,\n",
    "                    lr_val_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "            round(\n",
    "                recall_score(\n",
    "                    y_val,\n",
    "                    rf_val_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "            round(\n",
    "                recall_score(\n",
    "                    y_val,\n",
    "                    ens_val_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "        ],\n",
    "        # ROC-AUC measures how well the model separates\n",
    "        # employees who leave from those who stay.\n",
    "        \"ROC-AUC\": [\n",
    "            round(\n",
    "                roc_auc_score(\n",
    "                    (y_val == leave_class).astype(int),\n",
    "                    lr_val_proba,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "            round(\n",
    "                roc_auc_score(\n",
    "                    (y_val == leave_class).astype(int),\n",
    "                    rf_val_proba,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "            round(\n",
    "                roc_auc_score(\n",
    "                    (y_val == leave_class).astype(int),\n",
    "                    ens_val_proba,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "        ],\n",
    "    }\n",
    ")\n",
    "\n",
    "print(\"=== Validation Set Performance ===\")\n",
    "print(validation_results.to_string(index=False))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# STEP 2: PREDICTION STRATEGY\n",
    "# ============================================================\n",
    "\n",
    "# The Streamlit application uses both trained models when\n",
    "# generating the final employee attrition prediction.\n",
    "#\n",
    "# Each model produces its own probability of the employee leaving.\n",
    "# These two probabilities are then averaged to create one\n",
    "# combined attrition-risk score.\n",
    "\n",
    "print(\"\\n=== Prediction Strategy ===\")\n",
    "print(\"The application uses Logistic Regression and Random Forest.\")\n",
    "print(\"Both models produce an attrition probability.\")\n",
    "print(\"The two probabilities are averaged to produce the final risk score.\")\n",
    "print(\"A combined probability of 50% or higher indicates likely attrition.\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# STEP 3: FINAL TEST SET PERFORMANCE\n",
    "# ============================================================\n",
    "\n",
    "# The test set contains the final 15% of the dataset.\n",
    "# It is used only for the final evaluation of model performance.\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# LOGISTIC REGRESSION — TEST PREDICTIONS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Generate the final Logistic Regression class predictions.\n",
    "\n",
    "lr_pred = lr_model.predict(X_test)\n",
    "\n",
    "# Get the Logistic Regression probability of employee attrition.\n",
    "\n",
    "lr_proba = lr_model.predict_proba(X_test)[\n",
    "    :, list(lr_model.named_steps[\"logisticregression\"].classes_).index(leave_class)\n",
    "]\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# RANDOM FOREST — TEST PREDICTIONS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Generate the final Random Forest class predictions.\n",
    "\n",
    "rf_pred = rf_model.predict(X_test)\n",
    "\n",
    "# Get the Random Forest probability of employee attrition.\n",
    "\n",
    "rf_proba = rf_model.predict_proba(X_test)[\n",
    "    :, list(rf_model.named_steps[\"randomforestclassifier\"].classes_).index(leave_class)\n",
    "]\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# COMBINED FINAL PREDICTION\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Average the attrition probabilities from both models.\n",
    "#\n",
    "# This is the same probability-averaging approach used\n",
    "# by the Streamlit application for the final prediction.\n",
    "\n",
    "ens_proba = (lr_proba + rf_proba) / 2\n",
    "\n",
    "# Convert the combined probability into a binary prediction.\n",
    "#\n",
    "# 1 = Employee likely to leave\n",
    "# 0 = Employee likely to stay\n",
    "\n",
    "ens_pred = (ens_proba >= 0.50).astype(int)\n",
    "\n",
    "# Convert the actual test labels into binary values.\n",
    "# This is used when calculating ROC-AUC.\n",
    "\n",
    "y_bin = (y_test == leave_class).astype(int)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# FINAL MODEL PERFORMANCE\n",
    "# ============================================================\n",
    "\n",
    "# Create a final performance table comparing the two\n",
    "# individual models with their combined prediction.\n",
    "\n",
    "results = pd.DataFrame(\n",
    "    {\n",
    "        \"Model\": [\n",
    "            \"Logistic Regression\",\n",
    "            \"Random Forest\",\n",
    "            \"Combined Prediction\",\n",
    "        ],\n",
    "        \"Accuracy\": [\n",
    "            round(accuracy_score(y_test, lr_pred), 4),\n",
    "            round(accuracy_score(y_test, rf_pred), 4),\n",
    "            round(accuracy_score(y_test, ens_pred), 4),\n",
    "        ],\n",
    "        \"Precision\": [\n",
    "            round(\n",
    "                precision_score(\n",
    "                    y_test,\n",
    "                    lr_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "            round(\n",
    "                precision_score(\n",
    "                    y_test,\n",
    "                    rf_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "            round(\n",
    "                precision_score(\n",
    "                    y_test,\n",
    "                    ens_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "        ],\n",
    "        \"Recall\": [\n",
    "            round(\n",
    "                recall_score(\n",
    "                    y_test,\n",
    "                    lr_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "            round(\n",
    "                recall_score(\n",
    "                    y_test,\n",
    "                    rf_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "            round(\n",
    "                recall_score(\n",
    "                    y_test,\n",
    "                    ens_pred,\n",
    "                    pos_label=leave_class,\n",
    "                    zero_division=0,\n",
    "                ),\n",
    "                4,\n",
    "            ),\n",
    "        ],\n",
    "        \"ROC-AUC\": [\n",
    "            round(roc_auc_score(y_bin, lr_proba), 4),\n",
    "            round(roc_auc_score(y_bin, rf_proba), 4),\n",
    "            round(roc_auc_score(y_bin, ens_proba), 4),\n",
    "        ],\n",
    "    }\n",
    ")\n",
    "\n",
    "print(\"\\n=== FINAL TEST SET PERFORMANCE ===\")\n",
    "print(results.to_string(index=False))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# CONFUSION MATRICES — TEST SET\n",
    "# ============================================================\n",
    "\n",
    "# Confusion matrices show how many employees were:\n",
    "# - Correctly predicted to stay\n",
    "# - Correctly predicted to leave\n",
    "# - Incorrectly predicted to stay\n",
    "# - Incorrectly predicted to leave\n",
    "#\n",
    "# The three matrices allow us to compare the two models\n",
    "# and the combined prediction.\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 4))\n",
    "\n",
    "# Store each model's predictions and chart title\n",
    "# so that they can be plotted using one loop.\n",
    "\n",
    "plot_configs = [\n",
    "    (axes[0], lr_pred, \"Logistic Regression\"),\n",
    "    (axes[1], rf_pred, \"Random Forest\"),\n",
    "    (axes[2], ens_pred, \"Combined Prediction\"),\n",
    "]\n",
    "\n",
    "for ax, pred, name in plot_configs:\n",
    "    # Calculate the confusion matrix using the actual\n",
    "    # test labels and the model's predictions.\n",
    "\n",
    "    cm = confusion_matrix(y_test, pred)\n",
    "\n",
    "    # Display the confusion matrix as a heatmap.\n",
    "\n",
    "    sns.heatmap(\n",
    "        cm,\n",
    "        annot=True,\n",
    "        fmt=\"d\",\n",
    "        ax=ax,\n",
    "        cmap=\"Blues\",\n",
    "        xticklabels=[\"Stay\", \"Leave\"],\n",
    "        yticklabels=[\"Stay\", \"Leave\"],\n",
    "    )\n",
    "\n",
    "    ax.set_title(\n",
    "        f\"{name}\\nTest Confusion Matrix\",\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "\n",
    "    ax.set_xlabel(\"Predicted\")\n",
    "    ax.set_ylabel(\"Actual\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# ROC CURVES — TEST SET\n",
    "# ============================================================\n",
    "\n",
    "# ROC curves compare how well the models distinguish\n",
    "# employees who leave from employees who stay.\n",
    "#\n",
    "# A higher AUC generally indicates better class separation.\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "curve_configs = [\n",
    "    (lr_proba, \"Logistic Regression\"),\n",
    "    (rf_proba, \"Random Forest\"),\n",
    "    (ens_proba, \"Combined Prediction\"),\n",
    "]\n",
    "\n",
    "for proba, name in curve_configs:\n",
    "    # Calculate the False Positive Rate and\n",
    "    # True Positive Rate for different thresholds.\n",
    "\n",
    "    fpr, tpr, _ = roc_curve(y_bin, proba)\n",
    "\n",
    "    # Calculate the Area Under the ROC Curve.\n",
    "\n",
    "    auc = roc_auc_score(y_bin, proba)\n",
    "\n",
    "    # Plot the ROC curve for the current model.\n",
    "\n",
    "    plt.plot(\n",
    "        fpr,\n",
    "        tpr,\n",
    "        label=f\"{name} (AUC={auc:.3f})\",\n",
    "        linewidth=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# Random guessing baseline.\n",
    "# A model performing no better than random guessing\n",
    "# would follow approximately this diagonal line.\n",
    "\n",
    "plt.plot(\n",
    "    [0, 1],\n",
    "    [0, 1],\n",
    "    \"k--\",\n",
    "    linewidth=1,\n",
    "    label=\"Random Baseline\",\n",
    ")\n",
    "\n",
    "plt.xlabel(\"False Positive Rate\")\n",
    "plt.ylabel(\"True Positive Rate\")\n",
    "\n",
    "plt.title(\n",
    "    \"ROC Curve Comparison — Final Test Set\",\n",
    "    fontweight=\"bold\",\n",
    ")\n",
    "\n",
    "plt.legend()\n",
    "plt.grid(alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# CLASSIFICATION REPORTS — TEST SET\n",
    "# ============================================================\n",
    "\n",
    "# The classification reports provide detailed performance\n",
    "# information for both the Stay and Leave classes.\n",
    "\n",
    "\n",
    "# Logistic Regression performance\n",
    "\n",
    "print(\"\\n=== Logistic Regression Classification Report ===\")\n",
    "print(classification_report(y_test, lr_pred))\n",
    "\n",
    "\n",
    "# Random Forest performance\n",
    "\n",
    "print(\"=== Random Forest Classification Report ===\")\n",
    "print(classification_report(y_test, rf_pred))\n",
    "\n",
    "\n",
    "# Combined prediction performance\n",
    "\n",
    "print(\"=== Combined Prediction Classification Report ===\")\n",
    "print(classification_report(y_test, ens_pred))\n"
   ]

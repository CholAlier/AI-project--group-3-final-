    "# ============================================================\n",
    "# ATTRITION AUDIT BY DEMOGRAPHIC GROUPS\n",
    "# ============================================================\n",
    "\n",
    "# Create a copy of the original dataset so that the additional\n",
    "# AgeGroup column does not modify the original DataFrame.\n",
    "\n",
    "df_audit = df.copy()\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# CREATE AGE GROUPS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Divide employees into age ranges to examine whether\n",
    "# attrition differs across different age groups.\n",
    "\n",
    "df_audit[\"AgeGroup\"] = pd.cut(\n",
    "    df_audit[\"Age\"],\n",
    "    bins=[18, 25, 35, 45, 60],\n",
    "    labels=[\"18-25\", \"26-35\", \"36-45\", \"46-60\"],\n",
    ")\n",
    "\n",
    "# Create three charts in one row:\n",
    "# 1. Attrition by Gender\n",
    "# 2. Attrition by Age Group\n",
    "# 3. Attrition by Department\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(16, 4))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. ATTRITION RATE BY GENDER\n",
    "# ============================================================\n",
    "\n",
    "# Calculate the percentage of employees who left within\n",
    "# each gender group.\n",
    "\n",
    "gr = (\n",
    "    df_audit.groupby(\"Gender\")[\"Attrition\"]\n",
    "    .apply(lambda x: (x == \"Yes\").mean() * 100)\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# Rename the columns to make the result easier to understand.\n",
    "\n",
    "gr.columns = [\"Gender\", \"Rate\"]\n",
    "\n",
    "# Display the attrition rate for each gender using a bar chart.\n",
    "\n",
    "axes[0].bar(\n",
    "    gr[\"Gender\"],\n",
    "    gr[\"Rate\"],\n",
    "    color=[\"#63b3ed\", \"#f6ad55\"],\n",
    "    edgecolor=\"white\",\n",
    ")\n",
    "\n",
    "axes[0].set_title(\"Attrition Rate by Gender\", fontweight=\"bold\")\n",
    "\n",
    "axes[0].set_ylabel(\"Attrition Rate (%)\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. ATTRITION RATE BY AGE GROUP\n",
    "# ============================================================\n",
    "\n",
    "# Calculate the percentage of employees who left within\n",
    "# each age group.\n",
    "\n",
    "ar = (\n",
    "    df_audit.groupby(\"AgeGroup\", observed=True)[\"Attrition\"]\n",
    "    .apply(lambda x: (x == \"Yes\").mean() * 100)\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# Rename the columns for clarity.\n",
    "\n",
    "ar.columns = [\"AgeGroup\", \"Rate\"]\n",
    "\n",
    "# Display the attrition rate for each age group.\n",
    "\n",
    "axes[1].bar(\n",
    "    ar[\"AgeGroup\"].astype(str),\n",
    "    ar[\"Rate\"],\n",
    "    color=[\"#68d391\", \"#38b2ac\", \"#63b3ed\", \"#fc8181\"],\n",
    "    edgecolor=\"white\",\n",
    ")\n",
    "\n",
    "axes[1].set_title(\"Attrition Rate by Age Group\", fontweight=\"bold\")\n",
    "\n",
    "axes[1].set_ylabel(\"Attrition Rate (%)\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. ATTRITION RATE BY DEPARTMENT\n",
    "# ============================================================\n",
    "\n",
    "# Calculate the percentage of employees who left within\n",
    "# each department.\n",
    "\n",
    "dr = (\n",
    "    df_audit.groupby(\"Department\")[\"Attrition\"]\n",
    "    .apply(lambda x: (x == \"Yes\").mean() * 100)\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# Rename the columns for clarity.\n",
    "\n",
    "dr.columns = [\"Department\", \"Rate\"]\n",
    "\n",
    "# Display the attrition rate for each department.\n",
    "\n",
    "axes[2].bar(\n",
    "    dr[\"Department\"],\n",
    "    dr[\"Rate\"],\n",
    "    color=[\"#38b2ac\", \"#f6ad55\", \"#fc8181\"],\n",
    "    edgecolor=\"white\",\n",
    ")\n",
    "\n",
    "axes[2].set_title(\"Attrition Rate by Department\", fontweight=\"bold\")\n",
    "\n",
    "axes[2].set_ylabel(\"Attrition Rate (%)\")\n",
    "\n",
    "# Rotate department names slightly so they do not overlap.\n",

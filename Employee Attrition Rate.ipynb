   "source": [
    "# ============================================================\n",
    "# RANDOM FOREST FEATURE IMPORTANCE\n",
    "# ============================================================\n",
    "\n",
    "# List of categorical features that were converted into\n",
    "# multiple binary columns using OneHotEncoder.\n",
    "# We will combine their individual encoded importances\n",
    "# back into one importance score for each original feature.\n",
    "\n",
    "# Over18 is not listed here: it is a constant column and was\n",
    "# removed during preprocessing.\n",
    "cat_features = [\n",
    "    \"BusinessTravel\",\n",
    "    \"Department\",\n",
    "    \"EducationField\",\n",
    "    \"Gender\",\n",
    "    \"JobRole\",\n",
    "    \"MaritalStatus\",\n",
    "    \"OverTime\",\n",
    "]\n",
    "\n",
    "try:\n",
    "    # ------------------------------------------------------------\n",
    "    # ACCESS THE ENCODER AND RANDOM FOREST MODEL\n",
    "    # ------------------------------------------------------------\n",
    "\n",
    "    # Retrieve the OneHotEncoder step from the Random Forest pipeline.\n",
    "    # The encoder tells us the names of the transformed features.\n",
    "\n",
    "    ohe_step = rf_model.named_steps[\"onehotencoder\"]\n",
    "\n",
    "    # Retrieve the trained Random Forest classifier.\n",
    "    # It contains the feature_importances_ values.\n",
    "\n",
    "    rf_step = rf_model.named_steps[\"randomforestclassifier\"]\n",
    "\n",
    "    # ------------------------------------------------------------\n",
    "    # GET ENCODED FEATURE NAMES\n",
    "    # ------------------------------------------------------------\n",
    "\n",
    "    # Get the names of all features after OneHotEncoder transformation.\n",
    "    # For example, \"JobRole\" may become:\n",
    "    # JobRole_Healthcare Representative\n",
    "    # JobRole_Laboratory Technician\n",
    "    # JobRole_Manager, etc.\n",
    "\n",
    "    try:\n",
    "        enc_cols = list(ohe_step.get_feature_names_out())\n",
    "    except:\n",
    "        # Fallback for older encoder versions that may use\n",
    "        # feature_names instead of get_feature_names_out().\n",
    "        enc_cols = list(ohe_step.feature_names)\n",
    "\n",
    "    # ------------------------------------------------------------\n",
    "    # CREATE FEATURE IMPORTANCE TABLE\n",
    "    # ------------------------------------------------------------\n",
    "\n",
    "    # Match every encoded feature with its Random Forest\n",
    "    # importance score.\n",
    "\n",
    "    fi = pd.DataFrame({\"feature\": enc_cols, \"importance\": rf_step.feature_importances_})\n",
    "\n",
    "    # Store the final grouped feature importance results.\n",
    "    rows = []\n",
    "\n",
    "    # ------------------------------------------------------------\n",
    "    # GROUP ONE-HOT ENCODED CATEGORICAL FEATURES\n",
    "    # ------------------------------------------------------------\n",
    "\n",
    "    # One categorical feature can produce many encoded columns.\n",
    "    # For example, JobRole may produce several columns.\n",
    "    #\n",
    "    # We add all of those encoded importance scores together\n",
    "    # so that JobRole receives one overall importance score.\n",
    "\n",
    "    for cat in cat_features:\n",
    "        # Find encoded columns that belong to this original feature.\n",
    "        mask = fi[\"feature\"].str.startswith(cat)\n",
    "\n",
    "        # Only add the feature if matching encoded columns exist.\n",
    "        if mask.any():\n",
    "            rows.append(\n",
    "                {\"feature\": cat, \"importance\": fi.loc[mask, \"importance\"].sum()}\n",
    "            )\n",
    "\n",
    "    # ------------------------------------------------------------\n",
    "    # KEEP NUMERICAL FEATURES AS INDIVIDUAL FEATURES\n",
    "    # ------------------------------------------------------------\n",
    "\n",
    "    # Identify features that are not part of the categorical\n",
    "    # one-hot encoded variables.\n",
    "\n",
    "    num_mask = ~fi[\"feature\"].apply(\n",
    "        lambda f: any(f.startswith(c) for c in cat_features)\n",
    "    )\n",
    "\n",
    "    # Add the numerical features without grouping them.\n",
    "    rows.extend(fi[num_mask].to_dict(\"records\"))\n",
    "\n",
    "    # ------------------------------------------------------------\n",
    "    # SORT FEATURES BY IMPORTANCE\n",
    "    # ------------------------------------------------------------\n",
    "\n",
    "    # Create a DataFrame containing the grouped and numerical\n",
    "    # feature importance scores.\n",
    "    #\n",
    "    # Sort from most important to least important and keep\n",
    "    # only the top 15 features for visualization.\n",
    "\n",
    "    feat_imp = pd.DataFrame(rows).sort_values(\"importance\", ascending=False).head(15)\n",
    "\n",
    "    # ------------------------------------------------------------\n",
    "    # VISUALIZE TOP 15 FEATURES\n",
    "    # ------------------------------------------------------------\n",
    "\n",
    "    # Create a horizontal bar chart so the feature names\n",
    "    # are easy to read.\n",
    "\n",
    "    plt.figure(figsize=(9, 6))\n",
    "\n",
    "    plt.barh(\n",
    "        feat_imp[\"feature\"][::-1],\n",
    "        feat_imp[\"importance\"][::-1],\n",
    "        color=\"#38b2ac\",\n",
    "        edgecolor=\"white\",\n",
    "    )\n",
    "\n",
    "    # Add labels and title to the chart.\n",
    "\n",
    "    plt.xlabel(\"Importance Score\")\n",
    "    plt.title(\"Top 15 Feature Importances (Random Forest)\", fontweight=\"bold\")\n",
    "\n",
    "    # Adjust spacing so that labels and the chart fit properly.\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # ------------------------------------------------------------\n",
    "    # DISPLAY FEATURE IMPORTANCE VALUES\n",
    "    # ------------------------------------------------------------\n",
    "\n",
    "    # Print the numerical importance scores so they can be\n",
    "    # reviewed or included in the project analysis.\n",
    "\n",
    "    print(feat_imp[[\"feature\", \"importance\"]].to_string(index=False))\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# ERROR HANDLING\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# If the feature-importance analysis encounters an error,\n",
    "# display the error message instead of stopping the notebook.\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"Error: {e}\")"
   ]
